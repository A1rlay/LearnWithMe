generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Users ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id                 String              @id @default(cuid())
  /// Login handle, stored lowercase: [a-z0-9_.]{3,20}.
  username           String              @unique
  /// Optional (sign-up asks only for username + password); used for recovery later.
  email              String?             @unique
  passwordHash       String
  name               String
  role               Role                @default(STUDENT)
  bio                String?
  /// Free-text interest tags, lowercase, max 10.
  interests          String[]            @default([])
  discordHandle      String?
  /// Opt-in: discoverable as a study buddy and allowed to send requests.
  lookingForBuddies  Boolean             @default(false)
  /// Activities per week the learner aims for (shared with buddies). 1..14.
  weeklyGoal         Int                 @default(3)
  /// Set when the first-run flow is finished or skipped; null sends new users to /welcome.
  onboardedAt        DateTime?           @db.Timestamptz(3)
  /// IANA zone from the browser; days on the profile heatmap and streaks use it.
  timezone           String              @default("UTC")
  profileVisibility  ProfileVisibility   @default(MEMBERS)
  projects           LearningProject[]
  learning           LearnerSubject[]
  buddyRequestsSent  BuddyConnection[]   @relation("BuddyRequester")
  buddyPairsClosed   BuddyConnection[]   @relation("BuddyClosedBy")
  buddyPairsA        BuddyConnection[]   @relation("BuddyA")
  buddyPairsB        BuddyConnection[]   @relation("BuddyB")
  messagesSent       Message[]
  blocksMade         Block[]             @relation("Blocker")
  blocksReceived     Block[]             @relation("Blocked")
  reportsMade        Report[]            @relation("Reporter")
  reportsReceived    Report[]            @relation("Reported")
  sessions           QMSession[]
  classes            ClassStudent[]
  teaching           Class[]
  progress           VideoProgress[]
  spellRightSessions SpellRightSession[]
  expertIn           SubjectExpert[]
  videoAnswers       VideoAnswer[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// ─── Subjects & skills ────────────────────────────────────────────────────────
// A Subject (English, Math, Guitar…) is the top level learners browse. It is only
// listed while at least one expert (SubjectExpert) is assigned.

/// Who can open /u/<username>. Staff can always see it (classes, reports).
enum ProfileVisibility {
  MEMBERS // anyone signed in
  BUDDIES // accepted buddies only
  ONLY_ME
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  DONE
}

/// A learner's own goal, shown like a pinned repository on their profile.
model LearningProject {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title       String
  description String?
  url         String?
  status      ProjectStatus @default(ACTIVE)
  order       Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([subjectId])
}

enum ActivityType {
  VIDEO
  QUIZ
  SPELLING
}

model Subject {
  id             String            @id @default(cuid())
  name           String            @unique
  description    String?
  order          Int               @default(0)
  /// Activity kinds this subject offers (English: all three; most subjects: video + quiz).
  activityTypes  ActivityType[]    @default([VIDEO, QUIZ])
  experts        SubjectExpert[]
  skills         Skill[]
  topics         Topic[]
  qmTopics       QMTopic[]
  spellRightSets SpellRightSet[]
  learners       LearnerSubject[]
  projects       LearningProject[]
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
}

model SubjectExpert {
  subjectId  String
  userId     String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([subjectId, userId])
  @@index([userId])
}

// Skills are defined per subject by its experts. Activities are tagged with the
// skills they train; the join tables carry subjectId in BOTH composite FKs so the
// database refuses a tag whose skill belongs to another subject.
model Skill {
  id             String               @id @default(cuid())
  subjectId      String
  name           String
  order          Int                  @default(0)
  subject        Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics         TopicSkill[]
  qmTopics       QMTopicSkill[]
  spellRightSets SpellRightSetSkill[]
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([subjectId, name])
  @@unique([id, subjectId])
}

model TopicSkill {
  topicId   String
  skillId   String
  subjectId String
  topic     Topic  @relation(fields: [topicId, subjectId], references: [id, subjectId], onDelete: Cascade, onUpdate: Cascade)
  skill     Skill  @relation(fields: [skillId, subjectId], references: [id, subjectId], onDelete: Cascade)

  @@id([topicId, skillId])
  @@index([skillId, subjectId])
  @@index([topicId, subjectId])
}

model QMTopicSkill {
  topicId   String
  skillId   String
  subjectId String
  topic     QMTopic @relation(fields: [topicId, subjectId], references: [id, subjectId], onDelete: Cascade, onUpdate: Cascade)
  skill     Skill   @relation(fields: [skillId, subjectId], references: [id, subjectId], onDelete: Cascade)

  @@id([topicId, skillId])
  @@index([skillId, subjectId])
  @@index([topicId, subjectId])
}

model SpellRightSetSkill {
  setId     String
  skillId   String
  subjectId String
  set       SpellRightSet @relation(fields: [setId, subjectId], references: [id, subjectId], onDelete: Cascade, onUpdate: Cascade)
  skill     Skill         @relation(fields: [skillId, subjectId], references: [id, subjectId], onDelete: Cascade)

  @@id([setId, skillId])
  @@index([skillId, subjectId])
  @@index([setId, subjectId])
}

// ─── Classes ──────────────────────────────────────────────────────────────────

model Class {
  id          String            @id @default(cuid())
  name        String
  code        String            @unique
  teacherId   String
  teacher     User              @relation(fields: [teacherId], references: [id])
  students    ClassStudent[]
  assignments ClassAssignment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([teacherId])
}

model ClassAssignment {
  id        String    @id @default(cuid())
  classId   String
  topicId   String
  note      String?
  dueAt     DateTime?
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  topic     QMTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([classId, topicId])
  @@index([topicId])
}

model ClassStudent {
  classId   String
  studentId String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@id([classId, studentId])
  @@index([studentId])
}

// ─── WordCatch (video lessons) ────────────────────────────────────────────────

model Topic {
  id           String       @id @default(cuid())
  subjectId    String
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  skills       TopicSkill[]
  title        String
  description  String?
  level        String?
  /// Shown before the activity starts: what to do and what it practises.
  instructions String?
  tags         String[]
  videos       Video[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([id, subjectId])
  @@index([subjectId])
}

model Video {
  id               String          @id @default(cuid())
  topicId          String
  title            String
  description      String?
  videoUrl         String
  // Expert-controlled: on for beginner material, off when listening is the point.
  subtitlesEnabled Boolean         @default(false)
  order            Int             @default(0)
  topic            Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions        Question[]
  progress         VideoProgress[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([topicId])
}

model VideoProgress {
  id          String    @id @default(cuid())
  userId      String
  videoId     String
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, videoId])
  @@index([userId])
}

// ─── QuestionMaker ────────────────────────────────────────────────────────────

enum QMQuestionType {
  MULTIPLE_OPTION
  OPEN_ANSWER
  MATCHER
  CLASSIFIER
  FILL_BLANK
  TRUE_FALSE
  SENTENCE_ORDER
  WORD_SCRAMBLE
  FLASHCARD
}

enum QMSessionMode {
  PRACTICE
  TEST
  GAME
}

model QMTopic {
  id           String            @id @default(cuid())
  subjectId    String
  subject      Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  skills       QMTopicSkill[]
  title        String
  description  String?
  level        String?
  instructions String?
  order        Int               @default(0)
  questions    QMQuestion[]
  sessions     QMSession[]
  assignments  ClassAssignment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([id, subjectId])
  @@index([subjectId])
}

model QMQuestion {
  id        String         @id @default(cuid())
  topicId   String
  topic     QMTopic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  order     Int
  type      QMQuestionType
  prompt    String
  hint      String?
  data      Json
  answers   QMAnswer[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([topicId])
}

model QMSession {
  id          String        @id @default(cuid())
  topicId     String
  userId      String?
  mode        QMSessionMode @default(PRACTICE)
  topic       QMTopic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers     QMAnswer[]
  completedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([topicId])
  @@index([userId])
}

model QMAnswer {
  id         String     @id @default(cuid())
  sessionId  String
  session    QMSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  question   QMQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     Json
  isCorrect  Boolean?
  reviewedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([sessionId])
  @@index([questionId])
}

// ─── Learn With Me ────────────────────────────────────────────────────────────

model Question {
  id                String           @id @default(cuid())
  videoId           String
  prompt            String
  /// Optional nudge a learner can reveal before answering.
  hint              String?
  order             Int
  checkpointSeconds Int              @default(0)
  video             Video            @relation(fields: [videoId], references: [id], onDelete: Cascade)
  options           QuestionOption[]
  answers           VideoAnswer[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([videoId, order])
}

model QuestionOption {
  id         String        @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean       @default(false)
  order      Int
  question   Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    VideoAnswer[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([questionId, order])
  @@unique([id, questionId])
}

// One row per checkpoint answer a signed-in learner gives; graded on the server.
model VideoAnswer {
  id         String         @id @default(cuid())
  userId     String
  questionId String
  optionId   String
  isCorrect  Boolean
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // Composite FK: the chosen option must belong to the answered question.
  option     QuestionOption @relation(fields: [optionId, questionId], references: [id, questionId], onDelete: Cascade)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([questionId])
  @@index([optionId, questionId])
}

// ─── SpellRight ───────────────────────────────────────────────────────────────

enum SpellRightMode {
  TERMINATION
  PRONUNCIATION
}

model SpellRightSet {
  id           String               @id @default(cuid())
  subjectId    String
  subject      Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  skills       SpellRightSetSkill[]
  title        String
  description  String?
  level        String?
  instructions String?
  mode         SpellRightMode
  order        Int                  @default(0)
  words        SpellRightWord[]
  sessions     SpellRightSession[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([id, subjectId])
  @@index([subjectId])
}

model SpellRightWord {
  id            String             @id @default(cuid())
  setId         String
  set           SpellRightSet      @relation(fields: [setId], references: [id], onDelete: Cascade)
  word          String
  correctAnswer String?
  explanation   String?
  order         Int                @default(0)
  answers       SpellRightAnswer[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([setId])
}

model SpellRightSession {
  id          String             @id @default(cuid())
  setId       String
  userId      String?
  set         SpellRightSet      @relation(fields: [setId], references: [id], onDelete: Cascade)
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers     SpellRightAnswer[]
  completedAt DateTime?
  createdAt   DateTime           @default(now())

  @@index([setId])
  @@index([userId])
}

model SpellRightAnswer {
  id        String            @id @default(cuid())
  sessionId String
  session   SpellRightSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  wordId    String
  word      SpellRightWord    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  answer    String
  isCorrect Boolean
  createdAt DateTime          @default(now())

  @@index([sessionId])
  @@index([wordId])
}

// ─── Study buddies ────────────────────────────────────────────────────────────

/// Subjects a learner says they're studying (drives buddy suggestions).
model LearnerSubject {
  userId    String
  subjectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, subjectId])
  @@index([subjectId])
}

enum BuddyStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// One row per pair, stored canonically (userAId < userBId, CHECK in migration) so
/// A→B and B→A can never both exist. requesterId is one of the two.
model BuddyConnection {
  id          String      @id @default(cuid())
  userAId     String
  userBId     String
  requesterId String
  status      BuddyStatus @default(PENDING)
  /// Who moved it to DECLINED (decline, end or block). Declines stay silent: the other
  /// side keeps seeing "waiting", and only the closer may re-open it with a new request.
  closedById  String?
  /// Set when ever accepted — distinguishes "ended" from "declined".
  acceptedAt  DateTime?   @db.Timestamptz(3)
  userA       User        @relation("BuddyA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User        @relation("BuddyB", fields: [userBId], references: [id], onDelete: Cascade)
  requester   User        @relation("BuddyRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  closedBy    User?       @relation("BuddyClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  messages    Message[]
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  respondedAt DateTime?   @db.Timestamptz(3)

  @@unique([userAId, userBId])
  @@index([userBId])
  @@index([requesterId, createdAt])
  @@index([closedById])
}

model Message {
  id           String          @id @default(cuid())
  connectionId String
  senderId     String
  body         String
  connection   BuddyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sender       User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reports      Report[]
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  readAt       DateTime?       @db.Timestamptz(3)

  @@index([connectionId, createdAt])
  @@index([senderId, createdAt])
}

model Block {
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id         String    @id @default(cuid())
  reporterId String
  reportedId String
  messageId  String?
  reason     String
  reporter   User      @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User      @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  /// Kept if the message is deleted later (evidence), hence SetNull.
  message    Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)

  @@index([resolvedAt, createdAt])
  @@index([reporterId])
  @@index([reportedId])
  @@index([messageId])
}

/// Generic sliding-window rate limiting (serverless-safe: state lives in Postgres).
model RateEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([key, createdAt])
}
