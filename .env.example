# Postgres (pooled + direct URLs; same value is fine locally)
DATABASE_URL=postgresql://user:password@localhost:5432/learnwithme
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/learnwithme

# HMAC secret for session cookies — long random string, e.g. `openssl rand -hex 32`
AUTH_SECRET=

# Used by `npm run db:seed` only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
EXPERT_EMAIL=expert@example.com
EXPERT_PASSWORD=
